{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {"slug": "forest", "name": "フォレスト", "color": "#163d35"},
        {"slug": "ink", "name": "インク", "color": "#193c35"},
        {"slug": "muted", "name": "セカンダリー", "color": "#52665e"},
        {"slug": "paper", "name": "ペーパー", "color": "#f7f8f2"},
        {"slug": "white", "name": "ホワイト", "color": "#ffffff"},
        {"slug": "lime", "name": "ライム", "color": "#d9ec9b"},
        {"slug": "mist", "name": "ミスト", "color": "#e9ede3"}
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "System Sans",
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Hiragino Sans\", \"Yu Gothic Medium\", \"Yu Gothic\", Meiryo, sans-serif"
        }
      ],
      "fontSizes": [
        {"slug": "meta", "name": "Meta", "size": "0.75rem"},
        {"slug": "small", "name": "Small", "size": "0.875rem"},
        {"slug": "body", "name": "Body", "size": "1rem"},
        {"slug": "lead", "name": "Lead", "size": "clamp(1.0625rem, 1.15vw, 1.25rem)"},
        {"slug": "component-title", "name": "Component H3", "size": "clamp(1.375rem, 1.8vw, 1.75rem)"},
        {"slug": "section-title", "name": "Section H2", "size": "clamp(2rem, 3vw, 3rem)"},
        {"slug": "page-title", "name": "Page H1", "size": "clamp(2.5rem, 4vw, 3.75rem)"},
        {"slug": "display", "name": "Display / Hero", "size": "clamp(2.75rem, 4.6vw, 4.5rem)"}
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        {"slug": "inline", "name": "Inline", "size": "0.75rem"},
        {"slug": "copy", "name": "Heading to copy", "size": "1rem"},
        {"slug": "cluster", "name": "Control cluster", "size": "1.5rem"},
        {"slug": "component", "name": "Component padding", "size": "2rem"},
        {"slug": "section-header", "name": "Section header gap", "size": "clamp(2.5rem, 4vw, 4rem)"},
        {"slug": "section", "name": "Section gap", "size": "clamp(5rem, 7vw, 7rem)"}
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.85"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(20px,4vw,64px)",
        "right": "clamp(20px,4vw,64px)"
      }
    },
    "elements": {
      "link": {
        "color": {"text": "var:preset|color|forest"}
      },
      "heading": {
        "typography": {
          "fontWeight": "650",
          "lineHeight": "1.3",
          "letterSpacing": "0"
        }
      },
      "button": {
        "border": {"radius": "4px"},
        "color": {
          "background": "var:preset|color|forest",
          "text": "var:preset|color|white"
        },
        "typography": {
          "fontSize": "0.8125rem",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "20px",
            "right": "20px"
          }
        }
      }
    }
  }
}
