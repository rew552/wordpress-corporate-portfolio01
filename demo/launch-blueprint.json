{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Yohaku Works - WordPress Corporate Portfolio",
    "author": "Portfolio project",
    "description": "自主制作・架空企業。標準ブロックテーマと編集可能なデモ。"
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/",
  "login": true,
  "steps": [
    {
      "step": "setSiteLanguage",
      "language": "ja"
    },
    {
      "step": "runPHP",
      "code": "<?php $payload = json_decode(gzuncompress(base64_decode('')), true, 512, JSON_THROW_ON_ERROR); foreach ($payload['files'] as $path=>$content) { $target='/wordpress/wp-content/'.$path; if (!is_dir(dirname($target))) { mkdir(dirname($target),0777,true); } file_put_contents($target,$content); } foreach ($payload['binary'] as $file) { $target='/wordpress/wp-content/'.$file[0]; if (!is_dir(dirname($target))) { mkdir(dirname($target),0777,true); } file_put_contents($target,base64_decode($file[1])); }"
    },
    {
      "step": "activateTheme",
      "themeFolderName": "yohaku"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "yohaku-demo-form/yohaku-demo-form.php"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-content/yohaku-demo/setup.php';"
    }
  ]
}
