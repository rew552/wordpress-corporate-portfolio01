{
  "name": "wordpress-corporate-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "A WordPress corporate website portfolio showcasing responsive design and common business features.",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "audit": "node scripts/audit-source.mjs",
    "build": "node scripts/build.mjs",
    "start": "wp-playground-cli server --blueprint=blueprint.json --port=9400",
    "validate": "node scripts/audit-source.mjs && node scripts/validate.mjs",
    "quality:design": "node scripts/design-review.mjs",
    "quality:browser": "node scripts/design-review.mjs && node scripts/quality.mjs",
    "quality": "node scripts/run-quality.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@wp-playground/cli": "3.1.58",
    "ajv": "8.20.0",
    "playwright": "^1.64.1"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
